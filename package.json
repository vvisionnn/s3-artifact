{
	"name": "s3-artifact",
	"version": "1.0.0",
	"private": true,
	"description": "Drop-in replacement for actions/upload-artifact and actions/download-artifact backed by any S3-compatible storage",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"coverage": "bun test --coverage",
		"check": "bun run lint && bun run typecheck && bun run coverage && bun run build",
		"release": "bun run scripts/release.ts"
	},
	"dependencies": {
		"@actions/glob": "^0.7.0",
		"aws4fetch": "^1.0.20",
		"minimatch": "^11.0.4",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"git-cliff": "^2.14.2",
		"typescript": "^7.0.2"
	}
}
